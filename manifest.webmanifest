{
  "name": "Realot Hub",
  "short_name": "Realot",
  "description": "Browser-based 2D game engine \u2014 projects, editor and player.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#07070b",
  "theme_color": "#07070b",
  "orientation": "any",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "file_handlers": [
    {
      "action": "project/editor/",
      "accept": {
        "application/x-realot-project": [
          ".rs"
        ]
      },
      "icons": [
        {
          "src": "icons/rs-file-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "icons/rs-file-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "icons/rs-file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/rs-file-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}