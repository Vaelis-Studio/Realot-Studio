    }
  },
  {
    "name": "redo",
    "description": "Redo the last undone change.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "save_project",
    "description": "Save now (browser autosave slot, and the .realot file if one is being kept up to date).",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "list_assets",
    "description": "List imported sprites, animation-frame images, and audio assets without returning their binary data. Use the keys in SpriteRenderer, AudioSource, animation clips, and tilesets.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "all",
            "sprite",
            "audio",
            "frame"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "begin_asset_upload",
    "description": "Start uploading a sprite, audio file, animation source, or custom tileset image. Then send sequential base64 chunks with append_asset_upload_chunk and finish with complete_asset_upload. The editor must be open and connected. Maximum 12 MiB per file. Purpose 'project-zip' (a .realot/.zip project, max 12 MiB) REPLACES the entire open project and asks the person at the editor to confirm.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string",
          "maxLength": 240
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12582912
        },
        "purpose": {
          "type": "string",
          "enum": [
            "sprite",
            "audio",
            "animation-image",
            "animation-zip",
            "animation-gif",
            "animation-sheet",
            "tileset-sheet",
            "tileset-tile",
            "project-zip"
          ]
        },
        "entity_id": {
          "type": "string",
          "description": "Required for animation-image, animation-zip, animation-gif, and animation-sheet."
        },
        "clip_id": {
          "type": "string",
          "description": "Required for animation upload purposes."
        },
        "tileset_entity_id": {
          "type": "string",
          "description": "Required for tileset-sheet and tileset-tile."
        },
        "role": {
          "type": "string",
          "description": "Required for tileset-tile; use a role from list_tilesets."
        },
        "grid_cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "grid_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "file_name",
        "mime_type",
        "size_bytes",
        "purpose"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "append_asset_upload_chunk",
    "description": "Send one base64-encoded binary chunk for an active asset upload. Chunks must be independent base64 strings, sequential from index 0. Use the chunk size returned by begin_asset_upload; retrying the same index and data is safe.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string"
        },
        "chunk_index": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_base64": {
          "type": "string",
          "maxLength": 245760
        }
      },
      "required": [
        "upload_id",
        "chunk_index",
        "chunk_base64"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "complete_asset_upload",
    "description": "Validate and import all received bytes using the editor's native import pipeline. Call only after every chunk has been accepted.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string"
        }
      },
      "required": [
        "upload_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "cancel_asset_upload",
    "description": "Discard a staged upload before it is imported.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string"
        }
      },
      "required": [
        "upload_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "rename_asset",
    "description": "Rename an imported sprite, frame, or audio asset while preserving its key and references.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "sprite",
            "frame",
            "audio"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "key",
        "kind",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_asset",
    "description": "Delete an imported asset. If the asset is referenced by scenes or prefabs, the first call reports those references; set confirm=true only when it is acceptable to leave them unresolved.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "sprite",
            "frame",
            "audio"
          ]
        },
        "confirm": {
          "type": "boolean",
          "description": "Explicitly confirm deletion even when references exist."
        }
      },
      "required": [
        "key",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_animations",
    "description": "List animation clips and ordered frame keys for every entity in the active scene.",
    "inputSchema": {
      "type": "object",
