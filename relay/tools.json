          ]
        },
        "entity_id": {
          "type": "string"
        },
        "clip_id": {
          "type": "string"
        }
      },
      "required": [
        "panel"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "create_animation_clip",
    "description": "Create an empty animation clip on an entity, adding SpriteAnimation if needed, and open it in the animation editor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "fps": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        },
        "loop": {
          "type": "boolean"
        }
      },
      "required": [
        "entity_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "update_animation_clip",
    "description": "Change an animation clip name, frame rate, loop setting, or collider override. Set collider_override to null to remove the override.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "clip_id": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "fps": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 120
            },
            "loop": {
              "type": "boolean"
            },
            "collider_override": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "entity_id",
        "clip_id",
        "fields"
      ],
      "additionalProperties": false
